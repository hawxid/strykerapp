+                StringBuilder sb = new StringBuilder();
+                for (String l : out) sb.append(l).append("\n");
+                String all = sb.toString();
+                String cfg = all.contains("---SECRETS---") ? all.substring(0, all.indexOf("---SECRETS---")) : all;
+                String sec = all.contains("---SECRETS---") ? all.substring(all.indexOf("---SECRETS---")) : "";
+                java.util.regex.Matcher m = java.util.regex.Pattern.compile("^active_provider:\\s*(\\S+)", java.util.regex.Pattern.MULTILINE).matcher(cfg);
+                if (m.find()) curProvider = m.group(1).trim();
+                m = java.util.regex.Pattern.compile("^GOOSE_THINKING_EFFORT:\\s*(\\S+)", java.util.regex.Pattern.MULTILINE).matcher(cfg);
+                if (m.find()) curEffort = m.group(1).trim().toLowerCase();
+                // model under providers.<provider>:
+                m = java.util.regex.Pattern.compile("^  " + java.util.regex.Pattern.quote(curProvider) + ":\\s*\\n((?:    \\S.*\\n?)+)", java.util.regex.Pattern.MULTILINE).matcher(cfg);
+                if (m.find()) {
+                    java.util.regex.Matcher mm = java.util.regex.Pattern.compile("^    model:\\s*(\\S+)", java.util.regex.Pattern.MULTILINE).matcher(m.group(1));
+                    if (mm.find()) curModel = mm.group(1).trim();
