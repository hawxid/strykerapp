+    /** Write provider/model/effort/API key to goose config via chroot. */
+    private void saveProviderConfig(String provider, String model, String effort, String apiKey) {
+        new Thread(() -> {
+            try {
+                com.zalexdev.stryker.utils.Core core = new com.zalexdev.stryker.utils.Core(this);
+                // Map provider -> env var name for secrets.yaml
+                String keyName;
+                switch (provider) {
+                    case "openai": keyName = "OPENAI_API_KEY"; break;
+                    case "anthropic": keyName = "ANTHROPIC_API_KEY"; break;
+                    case "openrouter": keyName = "OPENROUTER_API_KEY"; break;
+                    case "groq": keyName = "GROQ_API_KEY"; break;
+                    case "deepseek": keyName = "DEEPSEEK_API_KEY"; break;
+                    default: keyName = "GOOGLE_API_KEY"; break;
+                }
+                StringBuilder py = new StringBuilder();
+                py.append("python3 - << 'PYEOF'\n");
+                py.append("import re, os\n");
+                py.append("cfg='/root/.config/goose/config.yaml'\n");
+                py.append("t=open(cfg).read()\n");
+                py.append("t=re.sub(r'^active_provider:.*', 'active_provider: ").append(provider.replace("'", "")).append("', t, flags=re.M)\n");
+                py.append("t=re.sub(r'^GOOSE_THINKING_EFFORT:.*', 'GOOSE_THINKING_EFFORT: ").append(effort.replace("'", "")).append("', t, flags=re.M)\n");
+                if (!model.isEmpty()) {
+                    // Update or add provider block with model
+                    py.append("prov='").append(provider.replace("'", "")).append("'\n");
+                    py.append("mod='").append(model.replace("'", "")).append("'\n");
+                    py.append("pat=re.compile(r'^  '+re.escape(prov)+r':\\s*\\n((?:    \\S.*\\n?)+)', re.M)\n");
+                    py.append("mm=pat.search(t)\n");
+                    py.append("if mm:\n");
+                    py.append("    blk=mm.group(0)\n");
+                    py.append("    blk2=re.sub(r'^    model:.*', '    model: '+mod, blk, flags=re.M)\n");
+                    py.append("    t=t[:mm.start()]+blk2+t[mm.end():]\n");
+                    py.append("else:\n");
+                    py.append("    t=re.sub(r'^(providers:\\s*\\n)', r'\\1  '+prov+':\\n    enabled: true\\n    model: '+mod+'\\n    configured: true\\n', t, flags=re.M)\n");
+                }
+                py.append("open(cfg,'w').write(t)\n");
+                if (!apiKey.isEmpty()) {
+                    py.append("sec='/root/.config/goose/secrets.yaml'\n");
+                    py.append("s=open(sec).read() if os.path.exists(sec) else ''\n");
+                    py.append("kn='").append(keyName).append("'\n");
+                    py.append("kv='''").append(apiKey.replace("'", "")).append("'''\n");
+                    py.append("import re as _re\n");
+                    py.append("s=_re.sub(r'^'+kn+r':.*', kn+': '+kv, s, flags=_re.M) if _re.search(r'^'+kn+r':', s, flags=_re.M) else s+kn+': '+kv+'\\n'\n");
+                    py.append("open(sec,'w').write(s)\n");
+                    py.append("os.system('chmod 600 '+sec)\n");
+                }
+                py.append("print('OK')\n");
+                py.append("PYEOF\n");
+                java.util.ArrayList<String> out = core.customChrootCommand(py.toString(), true);
+                boolean ok = false;
+                for (String l : out) if (l.trim().equals("OK")) ok = true;
+                final boolean fOk = ok;
+                ui(() -> {
+                    if (fOk) {
+                        android.widget.Toast.makeText(this, "Saved. Restart Ghost session to apply.", android.widget.Toast.LENGTH_LONG).show();
+                    } else {
+                        android.widget.Toast.makeText(this, "Save failed — check config.", android.widget.Toast.LENGTH_LONG).show();
+                    }
+                });
+            } catch (Exception e) {
+                ui(() -> android.widget.Toast.makeText(this, "Error: " + e.getMessage(), android.widget.Toast.LENGTH_LONG).show());
+            }
+        }).start();
+    }
