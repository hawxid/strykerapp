+    /**
+     * Replaces the last line in a TextView with new text.
+     * Used for '\r' (carriage return) updates that should refresh
+     * in place instead of appending.
+     */
+    private void replaceLastLine(android.widget.TextView tv, String line) {
+        CharSequence cs = tv.getText();
+        String current = cs != null ? cs.toString() : "";
+        // Find start of last line (after last '\n', ignoring trailing '\n')
+        int end = current.length();
+        while (end > 0 && current.charAt(end - 1) == '\n') end--;
+        int lastNl = end > 0 ? current.lastIndexOf('\n', end - 1) : -1;
+        int start = (lastNl >= 0) ? lastNl + 1 : 0;
+        tv.setText(current.substring(0, start) + line + "\n");
+    }
