@@ -0,0 +1,58 @@
+package com.zalexdev.stryker.bluetooth;
+
+import android.os.Bundle;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+import com.google.android.material.textfield.TextInputEditText;
+import com.zalexdev.stryker.R;
+import com.zalexdev.stryker.utils.Core;
+import java.util.ArrayList;
+
+public class BluetoothFragment extends Fragment {
+    private Core core;
+    private TextView output;
+    private TextInputEditText macInput;
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container, @Nullable Bundle savedInstanceState) {
+        View v = inflater.inflate(R.layout.fragment_bluetooth, container, false);
+        core = new Core(requireContext());
+        output = v.findViewById(R.id.bt_output);
+        macInput = v.findViewById(R.id.bt_mac_input);
+        v.findViewById(R.id.bt_btn_bluebinder).setOnClickListener(x -> runCmd("bluebinder"));
+        v.findViewById(R.id.bt_btn_up).setOnClickListener(x -> runCmd("hciconfig hci0 up && hciconfig"));
+        v.findViewById(R.id.bt_btn_interfaces).setOnClickListener(x -> runCmd("hciconfig"));
+        v.findViewById(R.id.bt_btn_scan).setOnClickListener(x -> runCmd("hcitool scan"));
+        v.findViewById(R.id.bt_btn_l2ping).setOnClickListener(x -> {
+            String mac = macInput.getText() != null ? macInput.getText().toString().trim() : "";
+            if (mac.isEmpty()) { output.setText("Masukkan MAC address dulu"); return; }
+            runCmd("l2ping -c 4 " + mac);
+        });
+        v.findViewById(R.id.bt_btn_sdp).setOnClickListener(x -> {
+            String mac = macInput.getText() != null ? macInput.getText().toString().trim() : "";
+            if (mac.isEmpty()) { output.setText("Masukkan MAC address dulu"); return; }
+            runCmd("sdptool browse " + mac);
+        });
+        return v;
+    }
+
+    private void runCmd(String cmd) {
+        output.setText("$ " + cmd + "\n...");
+        new Thread(() -> {
+            try {
+                ArrayList<String> out = core.customChrootCommand(cmd, true);
+                StringBuilder sb = new StringBuilder("$ " + cmd + "\n");
+                for (String l : out) sb.append(l).append("\n");
+                requireActivity().runOnUiThread(() -> output.setText(sb.toString()));
+            } catch (Exception e) {
+                requireActivity().runOnUiThread(() -> output.setText("Error: " + e.getMessage()));
+            }
+        }, "bt-cmd").start();
+    }
+}
