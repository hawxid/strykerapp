   internal fun applyColorScheme(view: TerminalView?, extraKeysView: ExtraKeysView?) {
     validateColors()
 
+    // MONDBG v4: background image PoC - reads /sdcard/Stryker/term_bg.png if present.
+    // v3 bug: drawable dipasang di TerminalView, jadi ikut mengkerut tiap view resize
+    // (extra keys muncul/hilang). v4: gambar dipasang di PARENT layout (ukurannya tetap),
