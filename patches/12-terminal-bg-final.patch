+          parent.background = drawable
+          view.setBackgroundColor(android.graphics.Color.TRANSPARENT)
+          bgImageOk = true
+        } else {
+          if (parent != null) {
+            parent.background = null
+          }
+        }
+      } catch (_: Exception) {
+      }
+    }
+
